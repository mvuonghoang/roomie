{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/roomie", "permanent": false },
    { "source": "/index.html", "destination": "/roomie", "permanent": false },
    { "source": "/trang-chu", "destination": "/roomie", "permanent": false },
    { "source": "/tim-phong", "destination": "/roomie/tim-phong", "permanent": false },
    { "source": "/khu-vuc-lang-dai-hoc", "destination": "/roomie/tim-phong", "permanent": false },
    { "source": "/phong-chi-tiet", "destination": "/roomie/phong-chi-tiet", "permanent": false },
    { "source": "/trac-nghiem", "destination": "/roomie/trac-nghiem", "permanent": false },
    { "source": "/trac-nghiem-hop-gu", "destination": "/roomie/trac-nghiem", "permanent": false },
    { "source": "/trac-nghiem-tinh-cach", "destination": "/roomie/trac-nghiem", "permanent": false },
    { "source": "/tim-roommate", "destination": "/roomie/tim-roommate", "permanent": false },
    { "source": "/ket-qua-match", "destination": "/roomie/tim-roommate", "permanent": false },
    { "source": "/dang-tin", "destination": "/roomie/dang-tin", "permanent": false },
    { "source": "/dang-tin-mien-phi", "destination": "/roomie/dang-tin", "permanent": false },
    { "source": "/dich-vu", "destination": "/roomie/bang-gia", "permanent": false },
    { "source": "/bang-gia", "destination": "/roomie/bang-gia", "permanent": false },
    { "source": "/ve-chung-toi", "destination": "/roomie/ve-chung-toi", "permanent": false },
    { "source": "/lien-he", "destination": "/roomie/lien-he", "permanent": false },
    { "source": "/an-toan", "destination": "/roomie/an-toan", "permanent": false },
    { "source": "/nguyen-tac-an-toan", "destination": "/roomie/an-toan", "permanent": false },
    { "source": "/bao-cao-tin-gia", "destination": "/roomie/an-toan", "permanent": false },
    { "source": "/lien-he-faq", "destination": "/roomie/an-toan", "permanent": false },
    { "source": "/quy-chuan-cong-dong", "destination": "/roomie/an-toan", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/roomie/api/:path*", "destination": "/api/index.js" },
    { "source": "/roomie", "destination": "/index.html" },
    { "source": "/roomie/index.html", "destination": "/index.html" },
    { "source": "/roomie/trang-chu", "destination": "/index.html" },
    { "source": "/roomie/tim-phong", "destination": "/pages/tim-phong.html" },
    { "source": "/roomie/khu-vuc-lang-dai-hoc", "destination": "/pages/tim-phong.html" },
    { "source": "/roomie/phong-chi-tiet", "destination": "/pages/phong-chi-tiet.html" },
    { "source": "/roomie/phong-chi-tiet-:id(\\d+)", "destination": "/pages/phong-chi-tiet.html" },
    { "source": "/roomie/trac-nghiem", "destination": "/pages/trac-nghiem.html" },
    { "source": "/roomie/trac-nghiem-hop-gu", "destination": "/pages/trac-nghiem.html" },
    { "source": "/roomie/trac-nghiem-tinh-cach", "destination": "/pages/trac-nghiem.html" },
    { "source": "/roomie/tim-roommate", "destination": "/pages/tim-roommate.html" },
    { "source": "/roomie/ket-qua-match", "destination": "/pages/tim-roommate.html" },
    { "source": "/roomie/dang-tin", "destination": "/pages/dang-tin.html" },
    { "source": "/roomie/dang-tin-mien-phi", "destination": "/pages/dang-tin.html" },
    { "source": "/roomie/dich-vu", "destination": "/pages/bang-gia.html" },
    { "source": "/roomie/bang-gia", "destination": "/pages/bang-gia.html" },
    { "source": "/roomie/ve-chung-toi", "destination": "/pages/ve-chung-toi.html" },
    { "source": "/roomie/lien-he", "destination": "/pages/lien-he.html" },
    { "source": "/roomie/an-toan", "destination": "/pages/an-toan.html" },
    { "source": "/roomie/nguyen-tac-an-toan", "destination": "/pages/an-toan.html" },
    { "source": "/roomie/bao-cao-tin-gia", "destination": "/pages/an-toan.html" },
    { "source": "/roomie/lien-he-faq", "destination": "/pages/an-toan.html" },
    { "source": "/roomie/quy-chuan-cong-dong", "destination": "/pages/an-toan.html" },
    { "source": "/roomie/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/roomie/styles/:path*", "destination": "/styles/:path*" },
    { "source": "/roomie/scripts/:path*", "destination": "/scripts/:path*" },
    { "source": "/roomie/favicon.ico", "destination": "/favicon.ico" }
  ]
}
