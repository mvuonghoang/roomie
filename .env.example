# Supabase PostgreSQL Connection String (Transaction or Session Pooler URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional runtime flags
PORT=3000
HOST=0.0.0.0
ROOMIE_ENABLE_DEMO_LOGIN=true
ROOMIE_ADMIN_PASSWORD=

# Optional for real VietQR transfers. Leave blank to generate a clear demo QR.
ROOMIE_VIETQR_BANK_BIN=
ROOMIE_VIETQR_BANK_NAME=
ROOMIE_VIETQR_ACCOUNT_NUMBER=
ROOMIE_VIETQR_ACCOUNT_NAME=
